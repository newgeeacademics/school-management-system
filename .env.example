# Main app (repo root) — landing, registration, /login, /dashboard
# Optional in local dev (defaults to http://localhost:8080). Required on Vercel production override.
VITE_API_URL=http://localhost:8080
VITE_USER_PORTAL_URL=http://localhost:5174

# Production examples:
# VITE_API_URL=https://school-management-system-gw9s.onrender.com
# Or omit VITE_API_URL — vercel.json proxies /api to Render (recommended on www.newgeeacademy.com)
# VITE_USER_PORTAL_URL=https://portal.newgeeacademy.com

# Sign in with Google (optional). OAuth 2.0 *Web* client ID from Google Cloud Console.
# Add this site's origin under "Authorized JavaScript origins". The backend must use the same ID (GOOGLE_CLIENT_ID).
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Sign in with Google through Firebase Authentication (Firebase console → Project settings →
# Your apps → Web app → firebaseConfig). Also set FIREBASE_PROJECT_ID on the API (Render).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Sign in by SMS: country code for numbers typed without one (default +225); false hides SMS sign-in.
VITE_DEFAULT_PHONE_PREFIX=+225
VITE_FIREBASE_PHONE_AUTH=
