VITE_API_URL=http://localhost:8080
# School staff login lives on the MAIN app (not admin-app port 5175)
VITE_MAIN_APP_URL=http://localhost:5173
# Admin console (separate app)
VITE_ADMIN_APP_URL=http://localhost:5175
# Live bus tracking (separate app)
VITE_TRACKING_APP_URL=http://localhost:5179

# Production:
# VITE_API_URL=https://school-management-system-gw9s.onrender.com
# VITE_MAIN_APP_URL=https://www.newgeeacademy.com
# VITE_ADMIN_APP_URL=https://admin.newgeeacademy.com
# VITE_TRACKING_APP_URL=https://tracker.newgeeacademy.com

# Sign in with Google through Firebase Authentication (Firebase console → Project settings →
# Your apps → Web app → firebaseConfig). Also set FIREBASE_PROJECT_ID on the API (Render).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
