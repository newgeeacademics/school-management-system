# Backend API (Spring Boot)
VITE_API_URL=http://localhost:8080

# Public main site (marketing)
VITE_MAIN_APP_URL=http://localhost:5173

# User portal (students, parents, teachers)
VITE_USER_PORTAL_URL=http://localhost:5174

# Mapbox — maps & geocoding (transport routes)
VITE_MAPBOX_TOKEN=

# Production examples:
# VITE_API_URL=https://school-management-system-gw9s.onrender.com
# VITE_MAIN_APP_URL=https://www.newgeeacademy.com
# VITE_USER_PORTAL_URL=https://portal.newgeeacademy.com

# Sign in with Google through Firebase Authentication (Firebase console → Project settings →
# Your apps → Web app → firebaseConfig). Also set FIREBASE_PROJECT_ID on the API (Render).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
